# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# Firebase is used for storage. The app automatically uses the configuration in firebase-applet-config.json.

# LinkedIn OAuth Credentials
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# SMTP Settings for Job Alerts
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Job Matcher Alert <your-email@gmail.com>"
